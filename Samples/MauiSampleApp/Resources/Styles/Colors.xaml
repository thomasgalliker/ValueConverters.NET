<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="PrimaryColor">#512BD4</Color>
    <Color x:Key="PrimaryDarkColor">#ac99ea</Color>
    <Color x:Key="PrimaryDarkTextColor">#242424</Color>
    <Color x:Key="SecondaryColor">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkTextColor">#9880e5</Color>
    <Color x:Key="TertiaryColor">#2B0B98</Color>

    <Color x:Key="WhiteColor">White</Color>
    <Color x:Key="BlackColor">Black</Color>
    <Color x:Key="MagentaColor">#D600AA</Color>
    <Color x:Key="MidnightBlueColor">#190649</Color>
    <Color x:Key="OffBlackColor">#1f1f1f</Color>

    <Color x:Key="Gray100Color">#E1E1E1</Color>
    <Color x:Key="Gray200Color">#C8C8C8</Color>
    <Color x:Key="Gray300Color">#ACACAC</Color>
    <Color x:Key="Gray400Color">#919191</Color>
    <Color x:Key="Gray500Color">#6E6E6E</Color>
    <Color x:Key="Gray600Color">#404040</Color>
    <Color x:Key="Gray900Color">#212121</Color>
    <Color x:Key="Gray950Color">#141414</Color>

    <Color x:Key="SamplePageBackgroundLightColor">#F5F7FA</Color>
    <Color x:Key="SamplePageBackgroundDarkColor">#101418</Color>
    <Color x:Key="SampleCardBackgroundDarkColor">#1B222B</Color>
    <Color x:Key="SampleTitleLightColor">#111827</Color>
    <Color x:Key="SampleTitleDarkColor">#F9FAFB</Color>
    <Color x:Key="SampleTextLightColor">#1D2430</Color>
    <Color x:Key="SampleTextDarkColor">#F3F6FA</Color>
    <Color x:Key="SampleMutedTextColor">#5C667A</Color>
    <Color x:Key="SampleSuccessColor">#027A48</Color>
    <Color x:Key="SampleSuccessDarkColor">#ABEFC6</Color>
    <Color x:Key="SampleSuccessLightColor">#ECFDF3</Color>
    <Color x:Key="SampleDangerColor">#B42318</Color>
    <Color x:Key="SampleInfoColor">#1849A9</Color>
    <Color x:Key="SampleInfoLightColor">#D1E9FF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100Color}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200Color}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300Color}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400Color}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500Color}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600Color}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900Color}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950Color}"/>
    <SolidColorBrush x:Key="SampleInfoLightBrush" Color="{StaticResource SampleInfoLightColor}"/>
    <SolidColorBrush x:Key="SampleSuccessLightBrush" Color="{StaticResource SampleSuccessLightColor}"/>
    <SolidColorBrush x:Key="SampleSuccessDarkBrush" Color="{StaticResource SampleSuccessDarkColor}"/>
</ResourceDictionary>
